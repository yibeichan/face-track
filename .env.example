# Storage for intermediate outputs and final results.
# Each pipeline stage writes under $SCRATCH_DIR/output/<NN_stage_name>/.
SCRATCH_DIR=/path/to/scratch/friends-char-track

# Root directory containing input videos organized by season.
# Expected layout: $VIDEO_DIR/s{1..N}/friends_s{NN}e{NN}{a,b,...}.mkv
VIDEO_DIR=/path/to/algonauts_2025/stimuli/movies/friends
